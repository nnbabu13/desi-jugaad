# ============================================================================
# Desi Jugaad - PRODUCTION environment template (placeholders only)
# ============================================================================
# Copy to `.env` at the repository root on the Oracle VM (the same location
# the dev `.env` uses - apps/api/main.ts loads `.env` from the working
# directory or `../../.env`), then fill in real values:
#
#     cp .env.production.example /opt/desi-jugaad/.env
#     chmod 600 /opt/desi-jugaad/.env
#
# NEVER commit the filled-in file (.gitignore excludes `.env*` except the
# example files). systemd loads this file via EnvironmentFile= before NestJS
# starts, so every value below must exist.
#
# Every variable listed here is read by the existing source code:
#   NODE_ENV          auth.service.ts, prisma.service.ts, http-exception.filter.ts
#   API_PORT          main.ts            (defaults to 4000)
#   DATABASE_URL      prisma.service.ts + prisma7.config.ts (throws if unset)
#   JWT_SECRET        auth.module.ts     (refuses "CHANGE_ME")
#   JWT_ACCESS_TTL    auth.module.ts / tokens.service.ts (defaults to 15m)
#   API_CORS_ORIGINS  main.ts            (comma separated origins)
#   AUTH_COOKIE_INSECURE  tokens.service.ts (cookie Secure flag)
# ============================================================================

# --- Runtime ----------------------------------------------------------------
NODE_ENV=production
API_PORT=4000

# --- Database ---------------------------------------------------------------
# Production runs ON the VM: PostgreSQL listens locally only. The development
# SSH-tunnel host/port (127.0.0.1:1521) must NOT be used in production - the
# API and the database are on the same machine.
DATABASE_URL="postgresql://desi_jugaad_user:CHANGE_ME@127.0.0.1:5432/desi_jugaad"

# --- Auth -------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="CHANGE_ME-use-at-least-48-random-bytes"
JWT_ACCESS_TTL="15m"

# --- Cookies ----------------------------------------------------------------
# MUST stay "false" in production: it keeps the refresh cookie Secure, which
# together with SameSite=None (derived in tokens.service.ts) is what allows
# the cross-site refresh from https://nnbabu13.github.io to the API host.
AUTH_COOKIE_INSECURE="false"

# --- CORS -------------------------------------------------------------------
# EXACT frontend origin(s). No path - never include /desi-jugaad here.
# credentials:true is already enabled in main.ts; an unknown origin is
# rejected, so this list must match the Pages URL host precisely.
API_CORS_ORIGINS="https://nnbabu13.github.io"

# --- Email ------------------------------------------------------------------
# No email/SMTP provider exists in the codebase today: email verification
# links are only logged outside production (auth.service.ts). If an SMTP
# provider is added later its variables get documented here - do not invent
# them now.
