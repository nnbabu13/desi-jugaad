# ============================================================================
# Desi Jugaad - environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
# ============================================================================

# --- Database ---------------------------------------------------------------
# Local development reaches the remote PostgreSQL through an SSH tunnel:
#   pnpm db:tunnel      (scripts/start-db-tunnel.ps1)
# which forwards localhost:1521 -> server 127.0.0.1:5432
DATABASE_URL="postgresql://desi_jugaad_user:CHANGE_ME@127.0.0.1:1521/desi_jugaad"
DATABASE_URL_TEST="postgresql://desi_jugaad_user:CHANGE_ME@127.0.0.1:1521/desi_jugaad_test"

# --- API --------------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
# Origins allowed by CORS (mobile dev server + web)
API_CORS_ORIGINS="http://localhost:8081,http://localhost:19006,http://localhost:3000"

# --- Auth -------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="CHANGE_ME"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
# Set to "true" only when testing over plain http (never in production)
AUTH_COOKIE_INSECURE="false"

# --- Storage ----------------------------------------------------------------
# "local" writes uploads to ./storage (dev). Swap to an S3-compatible adapter later.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_BUCKET=
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=

# --- Feature flags ----------------------------------------------------------
# Monetisation checkout is intentionally disabled: in-app purchases require
# Apple StoreKit / Google Play Billing. See docs/policy-risk-register.md
FEATURE_PROMOTIONS_CHECKOUT="false"
# AdMob is design-system slots only until native ad units are configured
FEATURE_ADS="false"

# --- Public site ------------------------------------------------------------
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_APP_NAME="Desi Jugaad"
NEXT_PUBLIC_APP_TAGLINE="Your community. Your city. Your connections."
